/-- A run of `CODE` from pc 0 with the selector of `eip712Domain()` that ends with no error
only reads: every storage word is as before and no log is added. -/
theorem ro_eip712Domain (hfork : .berlin ≤ fork)
    (hsize' : message.data.size < 2 ^ 256)
    (hsel : selector message.data = 0x84b0196e)
    {state : State.TransactionState} {substate : Substate}
    {gas : Nat} {evm s : Evm fork Nat}
    (start : At CODE message 0 [] .empty gas state substate evm)
    (hrun : EndsL runChild evm s) (hok : s.error = none) :
    Ro message.currentTarget state substate s.state s.substate := by
  obtain ⟨hc1, -, z, hz, hzr⟩ := Paths.ok_eip712DomainEntry hfork hsize' hsel start hrun hok
  exact eip712Domain_safe_549 hfork _ hz hzr hok

